# Environment Variables Template

# Copy to .env.local and fill with real values.

# GitHub
GITHUB_TOKEN=replace-with-personal-access-token
GITHUB_SYSTEM_USERNAME=nitsuah
# GitHub OAuth app used by NextAuth (lib auth.ts reads GITHUB_ID / GITHUB_SECRET).
# The OAuth app's callback URL must be:
#   https://gh-vigil.netlify.app/api/auth/callback/github
#   (local dev: http://localhost:3000/api/auth/callback/github)
GITHUB_ID=replace-with-oauth-client-id
GITHUB_SECRET=replace-with-oauth-client-secret
# Webhook secret — set this in GitHub repo settings > Webhooks > Secret
# Point the webhook at: https://<your-domain>/api/webhooks/github
GITHUB_WEBHOOK_SECRET=replace-with-random-secret

# Auth (NextAuth)
NEXTAUTH_URL=http://localhost:3000 #can be between 3000 and 3002 depending on your setup
NEXTAUTH_SECRET=replace-with-strong-secret

# Database (Neon/Postgres). lib/db.ts prefers NETLIFY_DATABASE_URL when set
# (Netlify's Neon integration sets it), and falls back to DATABASE_URL.
DATABASE_URL=postgresql://neondb_owner:replace-with-password@your-neon-host:5432/your-database
# NETLIFY_DATABASE_URL=postgresql://...   # takes precedence over DATABASE_URL if set

# Netlify
NETLIFY_SITE_ID=
NETLIFY_AUTH_TOKEN=

# App
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Vigil

# Feature flags
VIGIL_DEBUG=false

# Gemini API Key
GEMINI_API_KEY=replace-with-gemini-api-key....
# Gemini model defaults to models/gemini-2.5-flash with automatic discovery/fallback.
# Optional: override the model used by the application.
# GEMINI_MODEL_NAME=models/gemini-2.5-flash

# Optional: OpenAI fallback (priority 2)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4-turbo-preview  # Optional, defaults to this

# Optional: Anthropic fallback (priority 3)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022  # Optional, defaults to this

# Optional: BYOK overrides for per-provider keys (takes precedence over default keys)
# BYOK_GEMINI_API_KEY=replace-with-user-gemini-key
# BYOK_OPENAI_API_KEY=replace-with-user-openai-key
# BYOK_ANTHROPIC_API_KEY=replace-with-user-anthropic-key

# Required for the in-app BYOK Settings UI (per-user AI key, stored encrypted
# in user_ai_keys): any long random string, used to derive the AES-256-GCM
# key in lib/byok-crypto.ts. Without this, saving a personal key in Settings
# fails with a 503 but the app's own shared/default provider still works.
# BYOK_ENCRYPTION_KEY=replace-with-a-long-random-string

# MCP bearer key for POST /api/mcp and GET /api/context (Authorization: Bearer <key>).
# Generate with: openssl rand -hex 32. Unset means those endpoints reject all bearer calls.
# MCP_API_KEY=replace-with-openssl-rand-hex-32

# Optional: provider routing controls
# AI_PROVIDER_ORDER=gemini,openai,anthropic
# AI_DEPRIORITIZE_GEMINI_ON_QUOTA=true
# GEMINI_QUOTA_EXCEEDED=false