{
  "name": "vigil",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:dynamic": "node scripts/start-server.js",
    "lint": "eslint --config config/eslint.config.mjs",
    "setup-db": "tsx scripts/setup-db.ts",
    "migrate": "tsx scripts/migrate.ts",
    "check-schema": "tsx scripts/check-schema.ts",
    "test-query": "tsx scripts/test-query.ts",
    "test-gemini": "tsx scripts/test-gemini.ts",
    "test-gemini-direct": "tsx scripts/test-gemini-direct.ts",
    "test-gemini-health": "node scripts/test-gemini-health.mjs",
    "find-gemini-models": "node scripts/test-model-names.mjs",
    "list-gemini-models": "tsx scripts/list-models.ts",
    "test": "vitest --config config/vitest.config.ts",
    "prepare": "husky || true",
    "postinstall": "node -e \"const fs=require('fs'),f='node_modules/gray-matter/lib/engines.js';try{let c=fs.readFileSync(f,'utf8');c=c.replace('yaml.safeLoad.bind(yaml)','(yaml.load||yaml.safeLoad).bind(yaml)').replace('yaml.safeDump.bind(yaml)','(yaml.dump||yaml.safeDump).bind(yaml)');fs.writeFileSync(f,c);}catch(e){}\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@google/generative-ai": "^0.24.1",
    "@neondatabase/serverless": "^1.1.0",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "@octokit/rest": "^22.0.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "openai": "^7.15.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@netlify/functions": "^6.0.0",
    "@netlify/plugin-nextjs": "^5.15.13",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "baseline-browser-mapping": "^2.11.24",
    "dotenv": "^18.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "husky": "^9.1.7",
    "jsdom": "^30.0.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^6",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "js-yaml": "^5.2.3",
    "nanoid": "^3.3.18",
    "sharp": "^0.35.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --config config/eslint.config.mjs",
      "vitest related --run --config config/vitest.config.ts"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
